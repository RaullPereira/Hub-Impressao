{
  "name": "hub-impressao",
  "version": "1.9.5",
  "description": "Serviço de impressão térmica em background",
  "author": "Pedidos Hub",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "clean": "rm -rf dist node_modules",
    "clean:dist": "bash scripts/clean-dist.sh",
    "dev": "electron .",
    "install:mac": "npm install --no-optional",
    "install:win": "npm install",
    "postinstall": "node scripts/postinstall.js",
    "build:icons": "node scripts/generate-app-icon.js",
    "prebuild:win": "npm run build:icons",
    "prebuild": "npm run build:icons",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64 --ia32",
    "build:win7": "node scripts/build-win7-legacy.js",
    "build:senhas": "node scripts/build-senhas.js",
    "build:senhas:mac": "node scripts/build-senhas.js --mac",
    "build:senhas:all": "node scripts/build-senhas.js --all",
    "build:senhas:win7": "node scripts/build-senhas.js --win7",
    "build:win64": "electron-builder --win --x64",
    "build:win32": "electron-builder --win --ia32",
    "build:linux": "electron-builder --linux --x64",
    "build": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.8",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "express": "^4.18.2",
    "https": "^1.0.0",
    "node-fetch": "^2.7.0",
    "selfsigned": "^5.5.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "escpos-usb": "^3.0.0-alpha.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.seuprojeto.hubimpressao",
    "productName": "Hub Impressao",
    "files": [
      "build/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/printer/windows-spool-worker.ps1"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "icon": "assets/icons/app.icns",
      "identity": null,
      "target": [
        "zip",
        "pkg"
      ],
      "category": "public.app-category.utilities"
    },
    "afterPack": "scripts/after-pack-mac-adhoc.js",
    "win": {
      "icon": "assets/icons/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Hub-Impressao-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico",
      "include": "assets/installer.nsh"
    },
    "linux": {
      "icon": "assets/icons/app.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "Serviço de impressão térmica em background",
      "maintainer": "Pedidos Hub <suporte@pedidoshub.com.br>"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://jikxusxvolkbccnzswwp.supabase.co/storage/v1/object/public/Sistema%20de%20impressao/"
      }
    ]
  }
}
